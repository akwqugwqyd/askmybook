MONGODB_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
ADMIN_USER_IDS=

# RAG latency/quality: fast (default), balanced, or thorough
RAG_QUALITY_MODE=fast

# Optional hybrid retrieval and reranking controls
RAG_DENSE_CANDIDATES=12
RAG_LEXICAL_CANDIDATES=12
RAG_FUSED_CANDIDATES=16
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1
RAG_LEXICAL_WEIGHT=1
RAG_MIN_RELEVANCE_SCORE=0.2
RAG_MIN_RERANK_SCORE=0.35
# RAG_RERANKER_MODEL=gpt-4o-mini

# Optional observability pricing inputs
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Phoenix tracing. Leave the collector blank to disable trace export.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_HOST=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=ai-book-saas
PHOENIX_API_KEY=
# Content capture is off by default so document text and prompts are redacted.
PHOENIX_CAPTURE_CONTENT=false
PHOENIX_EVAL_ANNOTATIONS_REQUIRED=false

# Ragas evaluation models and regression thresholds
RAGAS_EVALUATOR_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_METRIC_TIMEOUT_SECONDS=180
RAGAS_MIN_FAITHFULNESS=0.75
RAGAS_MIN_ANSWER_RELEVANCY=0.65
RAGAS_MIN_ANSWER_CORRECTNESS=0.70
RAGAS_MIN_CONTEXT_PRECISION=0.65
RAGAS_MIN_CONTEXT_RECALL=0.75
