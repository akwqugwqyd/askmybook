# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (keep only sanitized templates)
.env*
!.env.example

# local package/provider credentials
.npmrc
.netrc
credentials*.json
service-account*.json
*.key
*.p12
*.pfx
*.jks
*.keystore

node_modules
.next

# Python virtual environments
venv/
env/
ENV/
.venv
.Python
*.pyc
__pycache__/
*.egg-info/
.pytest_cache/

# Local observability data (generated at runtime, not committed)
scripts/logs/traces/*.json
scripts/evals/traces.json
scripts/evals/results/*.json
scripts/.phoenix/
phoenix_config.json
traces.json
trace_analysis.json

# Keep template files but ignore results
!scripts/evals/golden_dataset.json
!scripts/evals/.gitkeep
!scripts/logs/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/
